// The Framework 16 Keyboard Control window, laid out like White Rabbit (and the Windows 11 Settings
// app): the menu on the left, the page on the right with its title above it. The bottom of the menu
// shows which devices are connected.
import { ScrollView } from "std-widgets.slint";
import { Theme, ThemeSync } from "theme.slint";
import { App, DeviceRow, Legend, EffectItem, EffectGroup, AudioLookItem } from "state.slint";
import { SectionTitle, Hint } from "widgets.slint";
import { HomePage } from "pages/home.slint";
import { LightingPage } from "pages/lighting.slint";
import { AudioPage } from "pages/audio.slint";
import { MacropadPage } from "pages/macropad.slint";
import { SetupPage } from "pages/setup.slint";
import { FirmwarePage } from "pages/firmware.slint";
import { SettingsPage } from "pages/settings.slint";
import { Deck } from "parts.slint";
import { KeysPage } from "pages/keys.slint";

export { Theme, App, DeviceRow, Legend, EffectItem, EffectGroup, AudioLookItem }

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 36px;
    border-radius: Theme.small-radius;
    background: selected ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: label;
    accessible-item-selected: selected;
    accessible-action-default => { clicked(); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if selected: Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    if focus.has-focus: Rectangle {
        border-width: 2px;
        border-color: Theme.text;
        border-radius: Theme.small-radius;
    }
    HorizontalLayout {
        padding-left: 16px;
        spacing: 14px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Image { source: icon; colorize: Theme.text; width: 16px; height: 16px; }
        }
        Text { text: label; color: Theme.text; font-size: Theme.body; vertical-alignment: center; }
    }
}

// The app's mark: a keyboard and a macropad, with a few lit keys
component Logo inherits Rectangle {
    width: 26px;
    height: 16px;
    Rectangle {
        x: 0;
        width: 19px;
        height: 16px;
        border-radius: 2px;
        border-width: 1px;
        border-color: Theme.text;
        for dot in 8: Rectangle {
            x: 3px + mod(dot, 4) * 4px;
            y: 4px + floor(dot / 4) * 5px;
            width: 2px;
            height: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        x: 21px;
        width: 5px;
        height: 16px;
        border-radius: 1.5px;
        border-width: 1px;
        border-color: Theme.text;
    }
}

export component AppWindow inherits Window {
    title: App.title;
    icon: @image-url("../assets/app.png");
    preferred-width: 1300px;
    preferred-height: 900px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.window-bg;
    default-font-size: Theme.body;

    property <[{key: string, label: string, icon: image}]> nav: [
        { key: "home", label: "Home", icon: @image-url("icons/home.svg") },
        { key: "lighting", label: "Lighting", icon: @image-url("icons/sparkle.svg") },
        { key: "audio", label: "Audio", icon: @image-url("icons/dark_theme.svg") },
        { key: "keys", label: "Key mapping", icon: @image-url("icons/key_edit.svg") },
        { key: "macropad", label: "Macropad", icon: @image-url("icons/grid.svg") },
        { key: "setup", label: "Your setup", icon: @image-url("icons/keyboard.svg") },
        { key: "firmware", label: "Firmware", icon: @image-url("icons/developer_board.svg") },
        { key: "settings", label: "Settings", icon: @image-url("icons/settings.svg") },
    ];

    function title-of(p: string) -> string {
        return p == "home" ? "Home" : p == "lighting" ? "Lighting" : p == "audio" ? "Audio" : p == "keys" ? "Key mapping" : p == "macropad" ? "Macropad"
            : p == "setup" ? "Your setup" : p == "firmware" ? "Firmware" : p == "settings" ? "Settings" : "";
    }

    ThemeSync { }

    HorizontalLayout {
        // The menu on the left
        VerticalLayout {
            width: 290px;
            padding: 8px;
            padding-top: 10px;
            spacing: 2px;
            HorizontalLayout {
                padding: 8px;
                padding-top: 6px;
                padding-bottom: 16px;
                spacing: 12px;
                alignment: start;
                VerticalLayout { alignment: center; Logo { } }
                Text { text: App.title; color: Theme.text2; font-size: Theme.caption; vertical-alignment: center; }
            }
            for item in nav: NavItem {
                icon: item.icon;
                label: item.label;
                selected: App.page == item.key;
                clicked => { App.page = item.key; }
            }
            Rectangle { vertical-stretch: 1; }
            // The devices and what the app found
            VerticalLayout {
                padding-left: 10px;
                padding-right: 6px;
                padding-bottom: 6px;
                vertical-stretch: 0;
                alignment: end;
                spacing: 2px;
                SectionTitle { text: "Devices"; }
                for d in App.devices: VerticalLayout {
                    Text { text: d.name; color: d.ok ? Theme.text : Theme.text2; }
                    Text {
                        text: d.status;
                        color: d.ok ? Theme.text2 : Theme.warn;
                        font-size: Theme.caption;
                        wrap: word-wrap;
                    }
                }
                Rectangle { height: 6px; }
                Hint { text: App.bar-status; color: App.live ? Theme.ok : Theme.text2; }
            }
        }
        // The page on the right, with its title above it
        VerticalLayout {
            padding-left: 16px;
            padding-right: 12px;
            HorizontalLayout {
                padding-top: 18px;
                padding-bottom: 14px;
                alignment: start;
                Text { text: title-of(App.page); color: Theme.text; font-size: Theme.title; font-weight: 600; }
            }
            // The keyboard picture stays put above the page, so you can see what you change
            // while the controls scroll underneath. Kept small (at most 760 px wide, about
            // 240 px tall) so the controls get most of the window.
            if App.page == "lighting" || App.page == "audio" || App.page == "keys" || App.page == "macropad" || App.page == "setup": Rectangle {
                height: deck.height + 12px;
                deck := Deck {
                    width: min(parent.width - 12px, 760px);
                    x: (parent.width - self.width) / 2;
                    y: 0;
                }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-right: 12px;
                    padding-bottom: 20px;
                    alignment: start;
                    if App.page == "home": HomePage { }
                    if App.page == "lighting": LightingPage { }
                    if App.page == "audio": AudioPage { }
                    if App.page == "keys": KeysPage { }
                    if App.page == "macropad": MacropadPage { }
                    if App.page == "setup": SetupPage { }
                    if App.page == "firmware": FirmwarePage { }
                    if App.page == "settings": SettingsPage { }
                }
            }
        }
    }
}
